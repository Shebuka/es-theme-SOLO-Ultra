<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<formatVersion>7</formatVersion>
	<variables>
		<delay>0</delay>
		<pandelay>1</pandelay>
	</variables>

	<view name="detailed, video">
		<video name="md_video">
			<delay>${delay}</delay>
			<showSnapshotDelay>false</showSnapshotDelay>
		</video>
	</view>

	<view name="grid">
		<imagegrid name="gamegrid">
			<showVideoAtDelay>${pandelay}</showVideoAtDelay>
		</imagegrid>
	</view>
</theme>
