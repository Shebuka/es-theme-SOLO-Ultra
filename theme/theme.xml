<?xml version="1.0" encoding="UTF-8"?>
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>

  <include>./config.xml</include>
  <include>./system.xml</include>
  <include>./gamelists.xml</include>

  <!-- base screen: controller activity, clock and battery overlays -->
  <view name="screen">

    <!-- battery (+ wifi/bluetooth) indicator, top-left -->
    <batteryIndicator name="batteryIndicator">
      <pos>0.0 0.0</pos>
      <size>0.20 0.05</size>
      <incharge>./_art/battery/incharge.svg</incharge>
      <full>./_art/battery/full.svg</full>
      <at75>./_art/battery/75.svg</at75>
      <at50>./_art/battery/50.svg</at50>
      <at25>./_art/battery/25.svg</at25>
      <empty>./_art/battery/empty.svg</empty>
      <color>FFFFFFA0</color>
    </batteryIndicator>

    <controllerActivity name="controllerActivity">
      <pos>0.0 0.2</pos>
      <size>0.2 0.1</size>
      <itemSpacing>0.003</itemSpacing>
      <horizontalAlignment>left</horizontalAlignment>
      <imagePath>./_art/gamepad.svg</imagePath>
      <color>${ccontroller}</color>
      <activityColor>${cactivity}</activityColor>
      <hotkeyColor>${chotkey}</hotkeyColor>
    </controllerActivity>

    <!-- clock, top-right -->
    <text name="clock">
      <color>${cclockcolor}</color>
      <fontSize>${fz_clock}</fontSize>
      <pos>0.99 0.00</pos>
      <origin>1 0</origin>
      <size>0.20 0.05</size>
      <alignment>right</alignment>
    </text>

  </view>

  <view name="menu, system, basic, detailed, grid, video">
    <!-- help bar -->
    <helpsystem name="help">
      <fontPath>./_inc/fonts/${font_system_desc}</fontPath>
      <fontSize>${fz_help}</fontSize>
      <textColor>${chelptext}</textColor>
      <iconColor>${chelptext}</iconColor>
      <iconUpDown>./_art/help_icons/default/updown.svg</iconUpDown>
      <iconLeftRight>./_art/help_icons/default/leftright.svg</iconLeftRight>
      <iconUpDownLeftRight>./_art/help_icons/default/all.svg</iconUpDownLeftRight>
      <iconL>./_art/help_icons/default/l.svg</iconL>
      <iconR>./_art/help_icons/default/r.svg</iconR>
      <iconStart>./_art/help_icons/${helpiconset}/start.svg</iconStart>
      <iconSelect>./_art/help_icons/${helpiconset}/select.svg</iconSelect>
      <iconA>./_art/help_icons/${helpiconset}/a.svg</iconA>
      <iconB>./_art/help_icons/${helpiconset}/b.svg</iconB>
      <iconX>./_art/help_icons/${helpiconset}/x.svg</iconX>
      <iconY>./_art/help_icons/${helpiconset}/y.svg</iconY>
      <pos>0.50 0.99</pos>
      <origin>0.50 1.00</origin>
    </helpsystem>

    <!-- Per-set directional/shoulder override template:
         when a set ships its own directional icons (e.g. XBox), add a second
         helpsystem with ifSubset to override only those paths. The baseline
         above keeps default/ as the fallback for every other set.
         ifSubset matches the subset name attribute in theme/config.xml.
    <helpsystem name="help" ifSubset="iconset:XBox|PSX">
      <iconUpDown>./_art/help_icons/${helpiconset}/updown.svg</iconUpDown>
      <iconLeftRight>./_art/help_icons/${helpiconset}/leftright.svg</iconLeftRight>
      <iconUpDownLeftRight>./_art/help_icons/${helpiconset}/all.svg</iconUpDownLeftRight>
      <iconL>./_art/help_icons/${helpiconset}/l.svg</iconL>
      <iconR>./_art/help_icons/${helpiconset}/r.svg</iconR>
    </helpsystem>
    -->

  </view>

  <!-- main menu -->
  <view name="menu">

    <menuText name="menufooter">
      <fontPath>./_inc/fonts/${font_menu_semibold}</fontPath>
      <fontSize>${fz_menu_footer}</fontSize>
      <color>${cmenufooter}</color>
    </menuText>

    <menuText name="menutext">
      <fontPath>./_inc/fonts/${font_menu_light}</fontPath>
      <fontSize>${fz_menu_text}</fontSize>
      <color>${cmenutext}</color>
      <separatorColor>${cmenuseperator}</separatorColor>
      <selectorColor>${cselector}</selectorColor>
      <selectorColorEnd>${cselectorend}</selectorColorEnd>
      <selectedColor>${cselected}</selectedColor>
      <selectorGradientType>${cgradienttype}</selectorGradientType>
    </menuText>

    <menuTextSmall name="menutextsmall">
      <fontPath>./_inc/fonts/${font_menu_semibold}</fontPath>
      <fontSize>${fz_menu_small}</fontSize>
      <color>${cmenusubtitle}</color>
    </menuTextSmall>

    <menuText name="menutitle">
      <fontPath>./_inc/fonts/${font_menu_semibold}</fontPath>
      <fontSize>${fz_menu_title}</fontSize>
      <color>${cmenutitle}</color>
    </menuText>

    <menuBackground name="menubg">
      <color>${cmenubg}</color>
      <path>./_art/back.png</path>
      <fadePath>./_art/fade.png</fadePath>
    </menuBackground>

    <menuIcons name="menuicons">
      <iconSystem>./_art/menu_icons/System.png</iconSystem>
      <iconUpdates>./_art/menu_icons/Updates.png</iconUpdates>
      <iconControllers>./_art/menu_icons/Controllers.png</iconControllers>
      <iconGames>./_art/menu_icons/Games.png</iconGames>
      <iconUI>./_art/menu_icons/UI.png</iconUI>
      <iconSound>./_art/menu_icons/Sound.png</iconSound>
      <iconNetwork>./_art/menu_icons/Network.png</iconNetwork>
      <iconScraper>./_art/menu_icons/Scraper.png</iconScraper>
      <iconAdvanced>./_art/menu_icons/Advanced.png</iconAdvanced>
      <iconQuit>./_art/menu_icons/Quit.png</iconQuit>
      <iconRetroachievements>./_art/menu_icons/Contest.png</iconRetroachievements>
      <iconKodi>./_art/menu_icons/Kodi.png</iconKodi>
      <iconRestart>./_art/menu_icons/Restart.png</iconRestart>
      <iconShutdown>./_art/menu_icons/Shutdown.png</iconShutdown>
      <iconFastShutdown>./_art/menu_icons/Fastshutdown.png</iconFastShutdown>
    </menuIcons>

  </view>

</theme>