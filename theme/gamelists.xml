<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>

  <!-- ============================================================
     Shared across all gamelist views
     ============================================================ -->
  <view name="basic, detailed, grid">

    <!-- full-screen background art (path set by bgset option) -->
    <image name="background">
      <origin>0.5 0.5</origin>
      <pos>0.5 0.5</pos>
      <minSize>1 1</minSize>
      <horizontalAlignment>center</horizontalAlignment>
    </image>

    <!-- help bar (font scales with screen width for tiny screens) -->
    <helpsystem name="help" if="${screen.width} &lt; 720">
      <fontSize>${fz_small_help}</fontSize>
    </helpsystem>

  </view>

  <!-- ============================================================
     basic view: simple list
     ============================================================ -->
  <view name="basic">
    <image name="logo">
      <origin>0.5 0.5</origin>
      <pos>0.5 0.075</pos>
      <maxSize>0.4 0.13</maxSize>
      <path>./_art/logos/${logoset}/${system.theme}.svg</path>
      <path>./_art/logos/${logoset}/${system.theme}.png</path>
    </image>
    <textlist name="gamelist">
      <pos>0.190 0.15</pos>
      <size>0.62 0.8</size>
      <scrollSound>./_art/sounds/ui/scroll.wav</scrollSound>
      <primaryColor>${cgamelisttext}</primaryColor>
      <selectedColor>${cselectedtext}</selectedColor>
      <selectorColor>${cselector}</selectorColor>
      <selectorColorEnd>${cselectorend}</selectorColorEnd>
      <selectorGradientType>${cgradienttype}</selectorGradientType>
      <fontPath>./_inc/fonts/${font_gamelist_items}</fontPath>
      <fontSize>${fz_gamelist}</fontSize>
      <lineSpacing>1.8</lineSpacing>
      <alignment>left</alignment>
    </textlist>

    <!-- background, enlarged by 0.003 on all sides -->
    <image name="gamelist_helper" extra="true">
      <origin>0 0</origin>
      <pos>0.187 0.147</pos>
      <size>0.626 0.806</size>
      <path>./_art/bg_color.png</path>
      <color>00000055</color>
      <zIndex>19</zIndex>
    </image>
  </view>

  <!-- ============================================================
     detailed view: list left, details right
     ============================================================ -->
  <view name="detailed">
    <image name="logo">
      <origin>0.5 0.5</origin>
      <pos>0.190 0.100</pos>
      <maxSize>0.34 0.10</maxSize>
      <path>./_art/logos/${logoset}/${system.theme}.svg</path>
      <path>./_art/logos/${logoset}/${system.theme}.png</path>
    </image>

    <!-- gamelist: left column -->
    <textlist name="gamelist">
      <pos>0.0200 0.1500</pos>
      <size>0.3400 0.81</size>
      <scrollSound>./_art/sounds/ui/scroll.wav</scrollSound>
      <primaryColor>${cgamelisttext}</primaryColor>
      <selectedColor>${cselectedtext}</selectedColor>
      <selectorColor>${cselector}</selectorColor>
      <selectorColorEnd>${cselectorend}</selectorColorEnd>
      <selectorGradientType>${cgradienttype}</selectorGradientType>
      <fontPath>./_inc/fonts/${font_gamelist_items}</fontPath>
      <fontSize>${fz_gamelist_detailed}</fontSize>
      <lineSpacing>1.8</lineSpacing>
      <alignment>left</alignment>
    </textlist>

    <image name="md_marquee">
      <origin>0.5 0.5</origin>
      <pos>0.6800 0.0900</pos>
      <maxSize>0.60 0.14</maxSize>
    </image>

    <rating name="md_rating">
      <origin>0.5 0.5</origin>
      <pos>0.68 0.17</pos>
      <size>0.25 0.05</size>
      <filledPath>./_art/gamelist_icons/rating_filled.svg</filledPath>
      <unfilledPath>./_art/gamelist_icons/rating_unfilled.svg</unfilledPath>
      <color>${crating}</color>
      <unfilledColor>808080</unfilledColor>
    </rating>

    <video name="md_video">
      <origin>0.5 0.5</origin>
      <pos>0.68 0.38</pos>
      <maxSize>0.60 0.40</maxSize>
      <delay>${video_delay_s}</delay>
      <showSnapshotDelay>true</showSnapshotDelay>
      <snapshotSource>image</snapshotSource>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
    </video>
    <!-- <image name="md_image">
      <origin>0.5 0.5</origin>
      <pos>0.6800 0.3800</pos>
      <maxSize>0.6000 0.4</maxSize>
    </image> -->

    <!-- metadata block, common init -->
    <text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount, md_lbl_gametime">
      <visible>false</visible>
    </text>
    <image name="e_dev_icon, e_genre_icon, e_pub_icon, e_date_icon, e_players_icon, e_count_icon, e_time_icon" extra="true">
